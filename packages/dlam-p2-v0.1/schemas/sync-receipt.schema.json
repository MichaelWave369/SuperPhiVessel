{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superphivessel.local/packages/dlam-p2-v0.1/schemas/sync-receipt.schema.json",
  "title": "PV-DLAM P2 Sync Receipt",
  "type": "object",
  "required": [
    "receipt_id",
    "receipt_hash",
    "body",
    "signature_b64"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "receipt_hash": {
      "type": "string",
      "minLength": 1
    },
    "signature_b64": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "object",
      "required": [
        "schema",
        "source_peer_id",
        "recipient_peer_id",
        "envelope_id",
        "status",
        "imported_local_ids",
        "authority_granted"
      ],
      "properties": {
        "schema": {
          "const": "superphivessel.dlam.p2.receipt.v0.1"
        },
        "source_peer_id": {
          "type": "string",
          "minLength": 1
        },
        "recipient_peer_id": {
          "type": "string",
          "minLength": 1
        },
        "envelope_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "imported_local_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority_granted": {
          "const": false
        }
      }
    }
  }
}

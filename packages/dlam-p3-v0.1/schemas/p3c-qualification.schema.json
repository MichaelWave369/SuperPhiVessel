{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superphivessel.local/packages/dlam-p3-v0.1/schemas/p3c-qualification.schema.json",
  "title": "PV-DLAM P3-C Qualification",
  "type": "object",
  "required": [
    "schema",
    "status",
    "requirements",
    "coverage",
    "seed_reports",
    "sfr_coverage",
    "gates",
    "technical_gates_passed",
    "evidence_class",
    "evidence_manifest_refs",
    "fixture_mode",
    "empirical_evidence_gate_passed",
    "p3_complete_structurally",
    "p4_evaluation_allowed",
    "learned_weights",
    "may_change_live_route",
    "may_change_live_thresholds",
    "authority_granted"
  ],
  "properties": {
    "schema": {
      "const": "superphivessel.dlam.p3c.qualification.v0.1"
    },
    "status": {
      "enum": [
        "BLOCKED_INSUFFICIENT_EVIDENCE",
        "STRUCTURAL_PASS_SYNTHETIC_ONLY",
        "READY_FOR_P4_EVALUATION"
      ]
    },
    "technical_gates_passed": {
      "type": "boolean"
    },
    "evidence_class": {
      "enum": [
        "SYNTHETIC_QUALIFICATION_FIXTURE",
        "REPLAY_BENCHMARK",
        "FIELD_OBSERVED"
      ]
    },
    "evidence_manifest_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "fixture_mode": {
      "type": "boolean"
    },
    "empirical_evidence_gate_passed": {
      "type": "boolean"
    },
    "p3_complete_structurally": {
      "type": "boolean"
    },
    "p4_evaluation_allowed": {
      "type": "boolean"
    },
    "learned_weights": {
      "type": "null"
    },
    "may_change_live_route": {
      "const": false
    },
    "may_change_live_thresholds": {
      "const": false
    },
    "authority_granted": {
      "const": false
    }
  }
}
